# Backend (copy to backend/.env)
DJANGO_SECRET_KEY=change-me
# Keep false anywhere reachable by others: debug error pages can show request details.
# Set to true only for local debugging.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# TomTom (search + routing), from developer.tomtom.com → Dashboard → API & SDK Keys
TOMTOM_API_KEY=

# Weather: Open-Meteo is free without a key. Set this only for a paid plan (no rate limits).
OPEN_METEO_API_KEY=

# Reverse proxies in front of Django (e.g. 1 behind a host's load balancer). Rate limits trust the
# client address only as seen by these; 0 means the direct socket address.
DJANGO_NUM_PROXIES=0
